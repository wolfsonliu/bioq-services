# gateway — non-secret topology for the LOCAL kind + OpenFaaS deploy.
# Checked into git; loaded into the gateway pod as a ConfigMap (envFrom) by
# deploy/openfaas/local-up.sh. Secrets (OIDC client secret, session secret,
# Postgres pw / DB URL) go in deploy/openfaas/.env.local → k8s Secret (envFrom,
# applied after this ConfigMap so it wins).

# Execution: async dispatch via the in-cluster OpenFaaS gateway.
GATEWAY_DISPATCH_BACKEND=openfaas
GATEWAY_OPENFAAS_GATEWAY_URL=http://gateway.openfaas.svc.cluster.local:8080

# Storage: gateway-proxied file IO over the hostPath shared volume.
GATEWAY_STORAGE_BACKEND=file
GATEWAY_FILE_BASE_DIR=/shared
GATEWAY_JOBS_BASE_DIR=/shared/gw_jobs
# Registry ConfigMap is mounted here (NOT the image's /opt/gateway default).
GATEWAY_REGISTRY_PATH=/etc/bioq/services.yaml

# Auth: localhost = VPC break-glass by default; `make local-up BYPASS_VPC=false`
# patches this off (env: override wins over envFrom).
GATEWAY_AUTH__BYPASS_VPC=true
# One issuer, two paths: pod verifies via cluster DNS (backchannel-dynamic),
# issuer pinned to the localhost frontend URL browser/bioq see.
GATEWAY_AUTH__JWT_JWKS_URL=http://keycloak.bioq.svc.cluster.local:8080/realms/bioq/protocol/openid-connect/certs
GATEWAY_AUTH__JWT_ISSUER=http://localhost:8081/realms/bioq
GATEWAY_AUTH__OIDC_ISSUER=http://keycloak.bioq.svc.cluster.local:8080/realms/bioq
GATEWAY_AUTH__OIDC_CLIENT_ID=bioq-gateway
