# gateway openfaas — COMPLETE non-secret config (generated by `make gen-config`).
# Every operator-relevant GATEWAY_* knob is listed with its default. Edit
# values in place (e.g. GATEWAY_OSS_BUCKET), then run `make check-config`.
# Secrets are commented placeholders — set them in deploy/openfaas/.env.local.
# DO NOT hand-edit structure: regenerate with `make gen-config`.

# === Execution / dispatch ===
# Execution backend: fc (Alibaba FC async) | http (in-process runner) | openfaas.
GATEWAY_DISPATCH_BACKEND=openfaas
# HTTP dispatch timeout to downstream (seconds).
GATEWAY_DISPATCH_TIMEOUT_SEC=60.0
# OpenFaaS gateway base URL (required when dispatch_backend=openfaas).
GATEWAY_OPENFAAS_GATEWAY_URL=http://gateway.openfaas.svc.cluster.local:8080
# anyio threadpool size for the sync /v1 handlers (I/O-bound; can exceed vCPUs).
GATEWAY_THREAD_POOL_SIZE=100

# === Storage ===
# Upload/result storage: oss (presigned direct) | file (gateway-proxied).
GATEWAY_STORAGE_BACKEND=file
# Shared-volume root for file storage (storage_backend=file).
GATEWAY_FILE_BASE_DIR=/shared
# OSS bucket for presigned upload/download (storage_backend=oss). Must EXIST under the
# OSS AK below, in oss_region.
GATEWAY_OSS_BUCKET=bioagent-inputs
# OSS region (also the FC region for status polling).
GATEWAY_OSS_REGION=cn-hangzhou
# Lifetime of presigned OSS URLs (seconds).
GATEWAY_PRESIGN_EXPIRY_SEC=900
# Path where downstream FC services mount the data-plane bucket.
GATEWAY_DOWNSTREAM_OSS_MOUNT=/mnt/oss

# === Auth — VPC bypass / JWT / OIDC ===
# Allow internal/localhost/*-vpc.fcapp.run callers to bypass JWT (break-glass). Set
# false for a public-facing gateway.
GATEWAY_AUTH__BYPASS_VPC=true
# Account id attributed to VPC-bypassed requests.
GATEWAY_AUTH__VPC_ACCOUNT_ID=internal_vpc
# Treat VPC-bypassed callers as admin (internal ops).
GATEWAY_AUTH__VPC_IS_ADMIN=true
# IdP JWKS URL for verifying Bearer tokens. Empty = JWT disabled.
GATEWAY_AUTH__JWT_JWKS_URL=http://keycloak.bioq.svc.cluster.local:8080/realms/bioq/protocol/openid-connect/certs
# Expected token issuer (iss). Empty = don't validate iss.
GATEWAY_AUTH__JWT_ISSUER=http://localhost:8081/realms/bioq
# Expected token audience (aud).
GATEWAY_AUTH__JWT_AUDIENCE=gateway-server
# Token claim carrying the user's groups.
GATEWAY_AUTH__JWT_GROUPS_CLAIM=groups
# Membership in this group ⇒ role=admin.
GATEWAY_AUTH__JWT_ADMIN_GROUP=bioq-admins
# How long to cache fetched JWKS (seconds).
GATEWAY_AUTH__JWT_JWKS_CACHE_TTL_SEC=3600
# OIDC issuer for the admin-console SSO (Authorization Code). Empty = SSO off.
GATEWAY_AUTH__OIDC_ISSUER=http://keycloak.bioq.svc.cluster.local:8080/realms/bioq
# OIDC client id for the admin console.
GATEWAY_AUTH__OIDC_CLIENT_ID=bioq-gateway
# OIDC client secret for the admin console.
# GATEWAY_AUTH__OIDC_CLIENT_SECRET=   # SECRET — set in deploy/openfaas/.env.local

# === Database ===
# SQLAlchemy URL for the user/job store.
# GATEWAY_DB_URL — injected via the gateway-secrets Secret (built from POSTGRES_* in .env.local)

# === FC control-plane (Alibaba OpenAPI) ===
# FC OpenAPI endpoint override — a BARE host, e.g.
# <account-id>.cn-hangzhou-internal.fc.aliyuncs.com (no scheme, no path). Empty = SDK
# default {region}.fc.aliyuncs.com.
GATEWAY_FC_ENDPOINT=
# FC OpenAPI access key id (env ALI_AK).
# ALI_AK=   # SECRET — set in deploy/openfaas/.env.local
# FC OpenAPI access key secret (env ALI_SK).
# ALI_SK=   # SECRET — set in deploy/openfaas/.env.local

# === Advanced ===
# Path to the downstream service registry (services.yaml).
GATEWAY_REGISTRY_PATH=/etc/bioq/services.yaml
# Root dir for per-job scratch.
GATEWAY_JOBS_BASE_DIR=/shared/gw_jobs
# HTTP listen port (usually driven by the image PORT env / compose).
GATEWAY_PORT=9000
# Signing key for the admin-console session cookie; set for multi-instance.
# GATEWAY_SESSION_SECRET=   # SECRET — set in deploy/openfaas/.env.local
