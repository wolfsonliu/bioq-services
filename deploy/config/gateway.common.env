# gateway — non-secret config shared by ALL deploy targets (ecs / compose / openfaas).
# Checked into git. Do NOT put secrets here (passwords, AK/SK, client/session
# secrets) — those live in each target's gitignored .env / .env.local.
# Consumed as container env by GatewaySettings (gateway/settings.py).

# OIDC/JWT contract (same realm shape everywhere)
GATEWAY_AUTH__JWT_AUDIENCE=gateway-server
GATEWAY_AUTH__JWT_GROUPS_CLAIM=groups
GATEWAY_AUTH__JWT_ADMIN_GROUP=bioq-admins

# anyio threadpool for the (sync) /v1 handlers; I/O-bound, can exceed vCPU count.
GATEWAY_THREAD_POOL_SIZE=100
