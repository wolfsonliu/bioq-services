# gateway — non-secret topology for the LOCAL full-stack docker-compose deploy
# (gateway + Keycloak + workers, all in one compose network).
# Checked into git. Secrets (OIDC client secret, session secret) go in
# deploy/compose/.env (gitignored). Layered after gateway.common.env; .env wins.

# Execution: plain submit/poll against each worker's in-process runner.
GATEWAY_DISPATCH_BACKEND=http

# Storage: gateway-proxied file IO over the shared volume (no OSS).
GATEWAY_STORAGE_BACKEND=file
GATEWAY_FILE_BASE_DIR=/shared

# Single-node SQLite (bundled compose has no external DB).
GATEWAY_DB_URL=sqlite:////data/gateway/gateway.db

# Auth: localhost = VPC break-glass by default; set false in .env to force OIDC.
GATEWAY_AUTH__BYPASS_VPC=true
# JWKS/token verified in-network; issuer is the browser/bioq-facing host URL.
# (KC_PORT default 8081 — if you change it, override JWT_ISSUER in .env.)
GATEWAY_AUTH__JWT_JWKS_URL=http://keycloak:8080/realms/bioq/protocol/openid-connect/certs
GATEWAY_AUTH__JWT_ISSUER=http://localhost:8081/realms/bioq
GATEWAY_AUTH__OIDC_ISSUER=http://keycloak:8080/realms/bioq
GATEWAY_AUTH__OIDC_CLIENT_ID=bioq-gateway
