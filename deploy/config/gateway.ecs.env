# gateway — non-secret topology for the PRODUCTION ECS + Alibaba FC deploy.
# Checked into git. Secrets (OSS AK/SK, ALI_SK, Postgres pw, OIDC client secret,
# session secret) and per-site overrides go in deploy/ecs/.env (gitignored).
# Layered after gateway.common.env; .env is applied last and wins.

# Execution: async dispatch to FC worker functions.
GATEWAY_DISPATCH_BACKEND=fc

# Storage: presigned direct-to-object OSS.
GATEWAY_STORAGE_BACKEND=oss
GATEWAY_OSS_BUCKET=bioagent-inputs
GATEWAY_OSS_REGION=cn-hangzhou
# Path where downstream FC services mount the data-plane bucket (services flagged
# oss_mount: true). Must match the downstream FC OSS mount point.
GATEWAY_DOWNSTREAM_OSS_MOUNT=/mnt/oss

# Auth: public-facing → require OIDC JWT (no VPC break-glass by default).
GATEWAY_AUTH__BYPASS_VPC=false

# --- bundled IdP (docker compose profile: idp) — see deploy/ecs/.env.example ---
# Site-AGNOSTIC defaults for the bundled Keycloak: the gateway fetches JWKS in the
# compose network and speaks OIDC as client bioq-gateway. The site-SPECIFIC parts
# (JWT_ISSUER / OIDC_ISSUER matching KC_HOSTNAME, the OIDC client secret) go in
# .env. For an EXTERNAL/managed IdP, leave the profile unset and OVERRIDE these two
# in .env (point JWKS + client id at your IdP).
GATEWAY_AUTH__JWT_JWKS_URL=http://keycloak:8080/realms/bioq/protocol/openid-connect/certs
GATEWAY_AUTH__OIDC_CLIENT_ID=bioq-gateway

# --- site-specific, non-secret: uncomment + set in deploy/ecs/.env for your site ---
# External-IdP overrides (replace the bundled-IdP defaults above):
# GATEWAY_AUTH__JWT_JWKS_URL=https://<idp-host>/realms/<realm>/protocol/openid-connect/certs
# GATEWAY_AUTH__JWT_ISSUER=https://<idp-host>/realms/<realm>
# GATEWAY_AUTH__OIDC_ISSUER=https://<idp-host>/realms/<realm>
# GATEWAY_AUTH__OIDC_CLIENT_ID=bioq-gateway
# FC OpenAPI endpoint — only if the host lacks public egress (intranet endpoint):
# GATEWAY_FC_ENDPOINT=<account-id>.cn-hangzhou-internal.fc.aliyuncs.com
