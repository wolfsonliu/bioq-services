# gateway — PRODUCTION ECS deployment secrets + site overrides.
# Copy to `.env` in this dir and fill in. `.env` is gitignored.
#
# Non-secret topology (dispatch/storage backend, OSS bucket/region, JWT
# audience/claims, thread pool) lives in the generated, complete
# ../config/gateway.ecs.env (checked in). This file is ONLY for secrets and
# per-site overrides; anything set here wins (env_file is applied last).
#
# docker compose reads this file for BOTH ${VAR} interpolation in
# docker-compose.yml (image/port/paths/POSTGRES_PASSWORD) AND container env.

# --- interpolation: image / runtime (host-side; override the compose defaults) ---
# GATEWAY_IMAGE=harbor.ruosheng.bio/aliyun_fc/gateway:latest
# GATEWAY_PORT=9000
# GATEWAY_DATA_DIR=./data           # persistent job scratch, mounted at /data
# GATEWAY_PG_DATA_DIR=./pgdata      # bundled postgres data files
# GATEWAY_REGISTRY_FILE=../../services.yaml   # downstream registry (repo root)

# --- database (secret) ---
# Bundled postgres: set the password (compose fails without it). The gateway URL
# is auto-composed from these in docker-compose.yml.
POSTGRES_USER=bioagent
POSTGRES_PASSWORD=
POSTGRES_DB=gateway
# To use an EXTERNAL/managed DB instead, set the full URL (overrides the composed
# one). Carries a password → keep it here, not in config/.
# GATEWAY_DB_URL=postgresql+psycopg://<user>:<pw>@<host>:5432/<db>?sslmode=require

# --- OSS (secret) ---
# The bucket/region are in ../config/gateway.ecs.env — the bucket must exist under
# this AK, or uploads fail with NoSuchBucket.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# --- FC OpenAPI (secret; RAM AK with InvokeFunction + GetAsyncTask) ---
# Without these the gateway falls back to HTTP status polling (spins downstream
# instances per poll — avoid for GPU services).
ALI_AK=
ALI_SK=

# --- auth (secrets) ---
GATEWAY_AUTH__OIDC_CLIENT_SECRET=
# Sign the admin-console session cookie. MUST be set (stable across restarts /
# replicas). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
GATEWAY_SESSION_SECRET=

# Any non-secret knob can be overridden here (wins over ../config/gateway.ecs.env)
# by setting its real name, e.g. GATEWAY_FC_ENDPOINT / GATEWAY_AUTH__JWT_ISSUER —
# see that file for the full list of knobs and defaults.

# --- bundled IdP (Keycloak) — quickstart for an internal deployment -----------
# Set COMPOSE_PROFILES=idp to run the bundled Keycloak (compose profile "idp"),
# giving a self-contained internal service with real OIDC auth and no external
# SSO. (COMPOSE_PROFILES is an interpolation var — it must live here in .env, not
# in ../config/*.env.) To front a managed/corp IdP instead, leave this unset and
# override GATEWAY_AUTH__JWT_JWKS_URL / JWT_ISSUER / OIDC_ISSUER / OIDC_CLIENT_ID
# (they default to the bundled keycloak in ../config/gateway.ecs.env).
# COMPOSE_PROFILES=idp
#
# Keycloak container (interpolation vars, host-side):
# KC_PORT=8081                         # host port; browser + bioq reach KC here
# KC_HOSTNAME=http://CHANGE-ME:8081    # this host's URL — MUST be reachable by
#                                      # clients (localhost only works via tunnel);
#                                      # becomes the token issuer.
# KC_ADMIN_PASSWORD=admin              # DEV default — CHANGE for anything real
# KC_IMAGE=quay.io/keycloak/keycloak:26.0
#
# Gateway auth for the bundled IdP (site-specific — must match KC_HOSTNAME):
# GATEWAY_AUTH__JWT_ISSUER=http://CHANGE-ME:8081/realms/bioq
# GATEWAY_AUTH__OIDC_ISSUER=http://CHANGE-ME:8081/realms/bioq
# And set GATEWAY_AUTH__OIDC_CLIENT_SECRET=bioq-gateway-secret above (matches the
# committed realm) + a GATEWAY_SESSION_SECRET for the admin-console cookie.
#
# NOTE — the imported realm ships THROWAWAY dev credentials (admin/admin, client
# secret bioq-gateway-secret) and only localhost:9000 admin-console redirect URIs:
#   * API access (bioq device-flow / client-credentials) works out of the box once
#     KC_HOSTNAME + JWT_ISSUER point at this host.
#   * admin-console browser SSO from a REMOTE host needs this host's redirect URI
#     added to the bioq-gateway client (KC admin console -> Clients -> bioq-gateway
#     -> Valid redirect URIs: http://CHANGE-ME:9000/*), or reach it via SSH tunnel.
#   * HARDEN before production: rotate the admin password + client secret, switch
#     keycloak to `start` + its own DB + TLS.
