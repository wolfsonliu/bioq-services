# LOCAL kind + OpenFaaS — gateway secrets. Copy to `.env.local` (gitignored).
# Loaded into the gateway pod as the `gateway-secrets` Secret by local-up.sh.
# OPTIONAL: with no .env.local, local-up.sh uses throwaway dev defaults that match
# the committed realm (bioq-gateway-secret / a local session secret).
#
# Non-secret topology (dispatch/storage/backend URLs, JWKS/issuer, JWT claims)
# lives in the generated, complete ../config/gateway.openfaas.env.
# Put ONLY secrets here. Do NOT set GATEWAY_DB_URL (local-up.sh computes it from
# the bundled postgres and injects it into the Secret).

GATEWAY_AUTH__OIDC_CLIENT_SECRET=bioq-gateway-secret
GATEWAY_SESSION_SECRET=change-me-local
