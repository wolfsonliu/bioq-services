# Copy to .env to override defaults (all optional).
# Image tags (e.g. to use registry-pushed images instead of local builds):
# GATEWAY_IMAGE=harbor.ruosheng.bio/aliyun_fc/gateway:latest
# DOCKQ_IMAGE=harbor.ruosheng.bio/aliyun_fc/dockq-server:latest
# Host port the gateway listens on:
# GATEWAY_PORT=9000
