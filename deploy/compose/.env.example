# LOCAL full-stack compose — secrets + overrides. Copy to .env (gitignored).
# ALL OPTIONAL: with no .env the stack runs on throwaway dev defaults (VPC bypass
# on, dev OIDC/session secrets matching the committed realm).
#
# Non-secret topology (dispatch=http, storage=file, Keycloak URLs, JWT claims)
# lives in the generated, complete ../config/gateway.compose.env (checked in).
# Put ONLY secrets / per-run overrides here.

# --- interpolation: image tags + host ports (override compose defaults) ---
# GATEWAY_IMAGE=harbor.ruosheng.bio/aliyun_fc/gateway:latest
# DOCKQ_IMAGE=harbor.ruosheng.bio/aliyun_fc/dockq-server:latest
# KC_IMAGE=quay.io/keycloak/keycloak:26.0
# GATEWAY_PORT=9000
# KC_PORT=8081                 # Keycloak (browser/bioq issuer = http://localhost:$KC_PORT)

# --- secrets (dev defaults exist; set for a non-throwaway local setup) ---
# OIDC_CLIENT_SECRET=bioq-gateway-secret     # must match the realm's bioq-gateway client
# GATEWAY_SESSION_SECRET=change-me           # sign admin-console session cookie
# KC_ADMIN_PASSWORD=admin                    # Keycloak master admin

# Any non-secret knob can be overridden here by its real name (wins over config/),
# e.g. GATEWAY_AUTH__BYPASS_VPC=false — see ../config/gateway.compose.env.
