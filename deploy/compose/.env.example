# Copy to .env to override defaults (all optional).
# Image tags (e.g. to use registry-pushed images instead of local builds):
# GATEWAY_IMAGE=harbor.ruosheng.bio/aliyun_fc/gateway:latest
# DOCKQ_IMAGE=harbor.ruosheng.bio/aliyun_fc/dockq-server:latest
# KC_IMAGE=quay.io/keycloak/keycloak:26.0

# Host ports:
# GATEWAY_PORT=9000
# KC_PORT=8081                 # Keycloak (browser/bioq issuer = http://localhost:$KC_PORT)

# Auth:
# BYPASS_VPC=true              # localhost bypass (dev). Set false for public deploys.
# OIDC_CLIENT_SECRET=bioq-gateway-secret   # must match the realm's bioq-gateway client
# GATEWAY_SESSION_SECRET=change-me-in-prod # sign admin-console session cookie
# KC_ADMIN_PASSWORD=admin      # Keycloak master admin (realm bioq bootstrap: admin/admin)
