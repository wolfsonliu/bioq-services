# Copy to ensemble-server.env (covered by root .gitignore via `.env` rule —
# but verify with `git check-ignore ensemble-server.env` before filling secrets).
#
# Field reference: services/ensemble-server/README.md → "配置（环境变量）"
# + "认证配置（VPC bypass + JWT + API Key）"

# ============================================================
# 1. Downstream FC method connections (at least one required)
# ============================================================
# Use the VPC URLs (cn-hangzhou-vpc.fcapp.run) since the server runs inside
# the same VPC — intra-VPC routing is faster and doesn't consume public
# bandwidth.  Source of truth: services/aliyun_fc_url.md

ENSEMBLE_FC_METHODS__ALPHAFOLD__FUNCTION=alphafold-server
ENSEMBLE_FC_METHODS__ALPHAFOLD__HTTP_BASE_URL=https://fc-alphafold-fcizetpnjc.cn-hangzhou-vpc.fcapp.run
ENSEMBLE_FC_METHODS__ALPHAFOLD__TASK_ENDPOINT=/api/tasks/fold

ENSEMBLE_FC_METHODS__ESMFOLD2__FUNCTION=esmfold2-server
ENSEMBLE_FC_METHODS__ESMFOLD2__HTTP_BASE_URL=https://fc-esmfold-spayusioug.cn-hangzhou-vpc.fcapp.run
ENSEMBLE_FC_METHODS__ESMFOLD2__TASK_ENDPOINT=/api/tasks/fold

ENSEMBLE_FC_METHODS__BOLTZ__FUNCTION=boltz-server
ENSEMBLE_FC_METHODS__BOLTZ__HTTP_BASE_URL=https://fc-boltz-kbioniejif.cn-hangzhou-vpc.fcapp.run
ENSEMBLE_FC_METHODS__BOLTZ__TASK_ENDPOINT=/api/tasks/predict_structure

ENSEMBLE_FC_METHODS__PROMERA__FUNCTION=promera-server
ENSEMBLE_FC_METHODS__PROMERA__HTTP_BASE_URL=https://fc-promera-adkrlhmlcq.cn-hangzhou-vpc.fcapp.run
ENSEMBLE_FC_METHODS__PROMERA__TASK_ENDPOINT=/api/tasks/cofold

# Disable a method without removing the lines:
# ENSEMBLE_FC_METHODS__PROMERA__ENABLED=false

# ============================================================
# 2. API keys (at least one for non-VPC-bypass access)
# ============================================================
# Generate:
#   SECRET=$(python -c "import secrets; print(secrets.token_urlsafe(32))")
#   SHA=$(echo -n "$SECRET" | sha256sum | awk '{print $1}')
#   echo "PLAINTEXT (give to caller): $SECRET"
#   echo "SHA256 (paste below):       $SHA"

ENSEMBLE_API_KEYS__0__KEY_ID=ek_internal_test
ENSEMBLE_API_KEYS__0__SECRET_HASH=<replace with sha256 hex of plaintext secret>
ENSEMBLE_API_KEYS__0__CUSTOMER_ID=internal_test
ENSEMBLE_API_KEYS__0__PLAN=internal

# Same SHA256 hashes should also be set on the FC deployment env so customers
# can use either URL with the same secret during the bake-in window.

# ============================================================
# 3. JWT verification (optional — leave JWKS_URL empty to disable)
# ============================================================
# ENSEMBLE_AUTH__JWT_JWKS_URL=https://fc-jwt-XXX.cn-hangzhou-vpc.fcapp.run/.well-known/jwks.json
# ENSEMBLE_AUTH__JWT_AUDIENCE=ensemble-server
# ENSEMBLE_AUTH__JWT_ISSUER=
# ENSEMBLE_AUTH__JWT_SUB_IS_CUSTOMER=true

# ============================================================
# 4. (Optional) Override jobs root
# ============================================================
# Defaults to /data/ensemble_jobs (set in the image's Dockerfile) — matches
# the FC deployment so jobs are mutually visible.  Override to isolate the
# swarm deployment during initial testing, then revert once confident:
# ENSEMBLE_JOBS_BASE_DIR=/data/ensemble_jobs_swarm
