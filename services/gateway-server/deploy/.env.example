# gateway-server deployment env — copy to `.env` in this dir and fill in.
# `.env` is read by docker compose for both ${VAR} substitution and container env.

# --- image / runtime ---
# Image to run: a local build tag (gateway-server:latest) or a registry ref.
GATEWAY_IMAGE=gateway-server:latest
# Host port to expose the gateway on.
GATEWAY_PORT=9000
# Host directory for persistent state (SQLite DB + job scratch); mounted at /data.
GATEWAY_DATA_DIR=./data

# --- OSS (presigned uploads) ---
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
GATEWAY_OSS_BUCKET=bioagent-inputs
GATEWAY_OSS_REGION=cn-hangzhou

# --- FC OpenAPI (GetAsyncTask status polling) ---
# RAM AccessKey with FC InvokeFunction + GetAsyncTask permissions. Without
# these, the gateway falls back to HTTP status polling (spins downstream
# instances per poll — avoid for GPU services).
ALI_AK=
ALI_SK=
# FC OpenAPI endpoint. Leave UNSET to use the default {region}.fc.aliyuncs.com
# (public endpoint — works when the host has egress, same one FCDispatcher uses).
# Only override with the exact intranet endpoint shown in the FC console if the
# host has no public egress, e.g.:
# GATEWAY_FC_ENDPOINT=<account-id>.cn-hangzhou-internal.fc.aliyuncs.com

# --- auth (optional) ---
# External JWT verification: point at the JWKS of services/jwt. Leave unset to
# rely on VPC bypass (internal callers) + API keys only.
# GATEWAY_AUTH__JWT_JWKS_URL=https://fc-jwt-XXX.cn-hangzhou-vpc.fcapp.run/.well-known/jwks.json
# GATEWAY_AUTH__JWT_AUDIENCE=gateway-server
# GATEWAY_AUTH__BYPASS_VPC=true
