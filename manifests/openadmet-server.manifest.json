  "endpoints": [
    {
      "method": "POST",
      "path": "/api/compare",
      "summary": "Post-hoc comparison of pre-trained models (Mode A) or their stats JSON (Mode B).",
      "description": "Post-hoc comparison of pre-trained models (Mode A) or their stats JSON (Mode B).",
      "operation_id": null,
      "request_content_type": "multipart/form-data",
      "request_schema_ref": "#/components/schemas/Body_compare_api_compare_post",
      "response_schema_ref": "#/components/schemas/JobInfo",
      "request_fields": [
        {
          "name": "model_stats_files",
          "type": "array[file]",
          "required": false,
          "description": null,
          "is_file": true,
          "default": [],
          "default_kind": "literal",
          "default_note": null
        },
        {
          "name": "model_names",
          "type": "string",
          "required": false,
          "description": "Pre-registered model names on NAS (Mode A).",
          "is_file": false,
          "default": "unset",
          "default_kind": "unset",
          "default_note": "empty when omitted"
        },
        {
          "name": "label_types",
          "type": "string",
          "required": false,
          "description": null,
          "is_file": false,
          "default": "unset",
          "default_kind": "unset",
          "default_note": "empty when omitted"
        },
        {
          "name": "labels",
          "type": "string",
          "required": false,
          "description": null,
          "is_file": false,
          "default": "unset",
          "default_kind": "unset",
          "default_note": "empty when omitted"
        },
        {
          "name": "task_names",
          "type": "string",
          "required": false,
          "description": null,
          "is_file": false,
          "default": "unset",
          "default_kind": "unset",
          "default_note": "empty when omitted"
        },
        {
          "name": "mt_id",
          "type": "string",
          "required": false,
          "description": "Multitask identifier — required when comparing multitask models.",
          "is_file": false,
          "default": "unset",
          "default_kind": "unset",
          "default_note": "only used when explicitly provided"
        },
        {
          "name": "report",
          "type": "boolean",
          "required": false,
          "description": "Generate a PDF report in addition to the JSON stats.",
          "is_file": false,
          "default": false,
          "default_kind": "literal",
          "default_note": null
        }
      ],
      "examples": [
        {
          "title": "Compare 2 pre-registered CYP models by biotarget label",
          "curl": "curl -X POST $URL/api/compare \\\n    -F 'model_names=cyp1a2-cyp2d6-cyp3a4-cyp2c9-chemeleon-v1' \\\n    -F 'model_names=cyp1a2-cyp2d6-cyp3a4-cyp3c9-chemeleon-baseline' \\\n    -F 'label_types=biotarget' -F 'label_types=biotarget' \\\n    -F 'mt_id=CYP3A4'",
          "python": null,
          "body": null,
          "notes": "Mode A — model_dir-based comparison with biotarget labels."
        },
        {
          "title": "Compare via pre-computed stats JSON",
          "curl": "curl -X POST $URL/api/compare \\\n    -F 'model_stats_files=@stats_a.json' \\\n    -F 'model_stats_files=@stats_b.json' \\\n    -F 'labels=modelA' -F 'labels=modelB' \\\n    -F 'task_names=pchembl_value_mean' \\\n    -F 'task_names=pchembl_value_mean' \\\n    -F 'report=true'",
          "python": null,
          "body": null,
          "notes": "Mode B — JSON stats + PDF report."
        }
      ]
    },
