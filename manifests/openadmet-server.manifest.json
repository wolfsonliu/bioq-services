          "required": false,
          "description": null,
          "is_file": false,
          "default": false,
          "default_kind": "literal",
          "default_note": null
        }
      ],
      "examples": [
        {
          "title": "Inline SMILES against a single model",
          "curl": "curl -X POST $URL/api/predict \\\n    -F 'input_smiles=CCCCC1=NC(=C(N1CC2=CC=C(C=C2)C3=CC=CC=C3C4=NNN=N4)CO)Cl,CC(=O)OC1=CC=CC=C1C(=O)O' \\\n    -F 'model_names=herg-chemeleon-baseline'",
          "python": null,
          "body": null,
          "notes": "Predict hERG pIC50 for 2 SMILES using the pre-staged model."
        },
        {
          "title": "CSV upload against multiple CYP + hERG models",
          "curl": "curl -X POST $URL/api/predict \\\n    -F 'input_csv=@my_compounds.csv' \\\n    -F 'model_names=herg-chemeleon-baseline' \\\n    -F 'model_names=cyp1a2-cyp2d6-cyp3a4-cyp2c9-chemeleon-v1'",
          "python": null,
          "body": null,
          "notes": "Multiple `-F 'model_names=X'` accumulate into a list. Server auto-derives input_col from the first model's data.yaml."
        },
        {
          "title": "Large batch via OSS URI + acquisition scoring",
          "curl": "curl -X POST $URL/api/predict \\\n    -F 'input_csv_uri=oss://my-bucket/screening/lib.csv' \\\n    -F 'model_names=cyp1a2-cyp2d6-cyp3a4-cyp2c9-chemeleon-v1' \\\n    -F 'aq_fxns=ucb' -F 'beta=1.5' \\\n    -F 'aq_fxns=ei'  -F 'xi=0.01' -F 'best_y=6.0'",
          "python": null,
          "body": null,
          "notes": "URI fallback for GB-scale CSVs. UCB β=1.5 + EI ξ=0.01 (best_y=6.0)."
        }
      ]
