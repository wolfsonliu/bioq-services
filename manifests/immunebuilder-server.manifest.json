  "job_lifecycle": {
    "poll_endpoint": "/api/jobs/{job_id}",
    "files_endpoint": "/api/jobs/{job_id}/files",
    "log_endpoint": "/api/jobs/{job_id}/log",
    "download_endpoint": "/api/jobs/{job_id}/download",
    "single_file_endpoint": "/api/jobs/{job_id}/file/{path}",
    "delete_endpoint": "/api/jobs/{job_id}",
    "statuses": [
      "pending",
      "running",
      "completed",
      "failed"
    ],
    "failure_kinds": [
      "subprocess_error",
      "no_outputs",
      "timeout",
      "dataset_invalid",
      "interrupted"
    ],
    "poll_recommendation": "Poll the status endpoint every 5–120 s until status ∈ {'completed', 'failed'}. On failure, JobInfo.error_summary holds a one-line exception summary and error_tail holds the trailing ~4 KB of the subprocess log — usually enough for triage without a separate /log fetch.",
    "restart_semantics": "Jobs survive process and FC instance restarts via a `job.json` sidecar in each job directory. Jobs that were RUNNING at the moment of restart are downgraded to FAILED with failure_kind='interrupted'."
  },
  "nas_layout": {
    "jobs_base_dir": "/data/immunebuilder_jobs",
    "per_job_structure": "<jobs_base_dir>/<job_id>/{input/, output/, logs/run.log, job.json}",
    "cross_instance_consistency": "When multiple FC instances mount the same NAS at jobs_base_dir, all of them can see each other's jobs via read-through cache on GET. Writes (create/update) only happen on the instance that owns the subprocess.",
    "cross_service_sharing": "Other bioagent services mounted on the same NAS can read this service's output files directly by path, avoiding HTTP round-trips. Example: another service does `Path('/data/rfantibody_jobs/<id>/output/file.qv').read_bytes()`."
  },
  "service_specific": {
    "tool_outputs": {
      "final_model": "output/final_model.pdb",
      "unrefined_models": "output/rank{0-3}_unrefined.pdb (save_all_models=True)",
      "error_estimates": "output/error_estimates.npy (save_all_models=True)"
    },
    "predictors": {
      "antibody": "ABodyBuilder2 — H + L chains",
      "nanobody": "NanoBodyBuilder2 — H chain only",
      "tcr": "TCRBuilder2 — A + B chains"
    },
    "numbering_schemes": [
      "imgt",
      "chothia",
      "kabat",
      "aho",
      "wolfguy",
      "martin",
      "raw"
    ],
    "paper_reference": "DOI:10.1038/s42003-023-04927-7"
  },
  "openapi_url": "/openapi.json"
}
