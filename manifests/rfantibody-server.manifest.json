          "python": "r = httpx.post(\n    f'{base_url}/api/rf2',\n    data={\n        'input_quiver_uri': f'job://{proteinmpnn_job_id}/2_proteinmpnn.qv',\n        'num_recycles': 10,\n    },\n)",
          "body": null,
          "notes": "Final step; output is 3_rf2.qv with binder + target structures + scores."
