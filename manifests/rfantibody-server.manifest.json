      "operation_id": null,
      "request_content_type": "multipart/form-data",
      "request_schema_ref": "#/components/schemas/Body_run_rfdiffusion_api_rfdiffusion_post",
      "response_schema_ref": "#/components/schemas/JobInfo",
      "request_fields": [
        {
          "name": "target",
          "type": "file",
          "required": false,
          "description": "Target antigen PDB. Mutually exclusive with `target_uri`.",
          "is_file": true,
          "default": null,
          "default_kind": null,
          "default_note": null
        },
        {
          "name": "target_uri",
          "type": "string",
          "required": false,
          "description": "URI to fetch the target instead of uploading. Schemes: job://<id>/<file>, file:///path, oss://<bucket>/<key>, http(s)://...",
          "is_file": false,
          "default": null,
          "default_kind": null,
          "default_note": null
        },
        {
          "name": "framework",
          "type": "file",
          "required": false,
          "description": "Antibody framework PDB. Mutually exclusive with `framework_uri`.",
          "is_file": true,
          "default": null,
          "default_kind": null,
          "default_note": null
        },
        {
          "name": "framework_uri",
          "type": "string",
          "required": false,
          "description": "URI to fetch the framework instead of uploading.",
          "is_file": false,
          "default": null,
          "default_kind": null,
          "default_note": null
        },
        {
          "name": "num_designs",
          "type": "integer",
          "required": false,
          "description": null,
          "is_file": false,
          "default": 10,
          "default_kind": "literal",
          "default_note": null
        },
        {
          "name": "design_loops",
          "type": "string",
          "required": false,
          "description": null,
          "is_file": false,
          "default": "H1:,H2:,H3:",
          "default_kind": "literal",
          "default_note": null
        },
        {
          "name": "hotspots",
          "type": "string",
          "required": false,
          "description": null,
          "is_file": false,
          "default": "unset",
          "default_kind": "unset",
          "default_note": "only used when explicitly provided"
        },
        {
          "name": "diffuser_t",
          "type": "integer",
          "required": false,
          "description": null,
          "is_file": false,
          "default": 50,
          "default_kind": "literal",
          "default_note": null
        },
        {
          "name": "final_step",
          "type": "integer",
          "required": false,
          "description": null,
          "is_file": false,
          "default": 1,
          "default_kind": "literal",
          "default_note": null
        },
        {
          "name": "deterministic",
          "type": "boolean",
          "required": false,
          "description": null,
          "is_file": false,
          "default": false,
          "default_kind": "literal",
          "default_note": null
        },
        {
          "name": "no_trajectory",
          "type": "boolean",
          "required": false,
          "description": null,
          "is_file": false,
          "default": true,
          "default_kind": "literal",
          "default_note": null
        }
      ],
      "examples": [
        {
          "title": "basic backbone design",
          "curl": "curl -X POST $URL/api/rfdiffusion -F target=@antigen.pdb -F framework=@framework.pdb -F num_designs=100 -F 'design_loops=H1:7,H2:6,H3:5-13' -F 'hotspots=B146,B170,B177'",
          "python": "import httpx\nwith open('antigen.pdb','rb') as t, open('framework.pdb','rb') as f:\n    r = httpx.post(\n        f'{base_url}/api/rfdiffusion',\n        files={'target': t, 'framework': f},\n        data={'num_designs': 100, 'hotspots': 'B146,B170,B177'},\n        timeout=120,\n    )\njob_id = r.json()['job_id']",
          "body": null,
          "notes": "Both PDB files are required uploads. Returns JobInfo immediately."
        }
      ]
    },
