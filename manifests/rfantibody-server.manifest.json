{
  "service": "rfantibody",
  "title": "RFantibody Server",
  "version": "0.0.22",
  "description": null,
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/proteinmpnn",
      "summary": "ProteinMPNN CDR sequence design over an RFdiffusion-generated backbone set.",
      "description": "ProteinMPNN CDR sequence design over an RFdiffusion-generated backbone set.",
      "operation_id": null,
      "request_content_type": "multipart/form-data",
      "request_schema_ref": "#/components/schemas/Body_run_proteinmpnn_api_proteinmpnn_post",
      "response_schema_ref": "#/components/schemas/JobInfo",
      "request_fields": [
        {
          "name": "input_quiver",
          "type": "file",
          "required": false,
          "description": "Input Quiver (from RFdiffusion). Mutually exclusive with `input_quiver_uri`.",
          "is_file": true,
          "default": null,
          "default_kind": null,
          "default_note": null
        },
        {
          "name": "input_quiver_uri",
          "type": "string",
          "required": false,
          "description": "URI to fetch the input Quiver instead of uploading. Schemes: job://<id>/<file>, file:///path, oss://<bucket>/<key>, http(s)://...",
          "is_file": false,
          "default": null,
          "default_kind": null,
          "default_note": null
        },
        {
          "name": "loops",
          "type": "string",
          "required": false,
          "description": null,
          "is_file": false,
          "default": "H1,H2,H3",
          "default_kind": "literal",
          "default_note": null
        },
        {
          "name": "seqs_per_struct",
          "type": "integer",
          "required": false,
          "description": null,
          "is_file": false,
          "default": 4,
          "default_kind": "literal",
          "default_note": null
        },
        {
          "name": "temperature",
          "type": "number",
          "required": false,
          "description": null,
          "is_file": false,
          "default": 0.2,
          "default_kind": "literal",
          "default_note": null
        },
        {
          "name": "omit_aas",
          "type": "string",
          "required": false,
          "description": null,
          "is_file": false,
          "default": "CX",
          "default_kind": "literal",
          "default_note": null
        },
        {
          "name": "deterministic",
          "type": "boolean",
          "required": false,
          "description": null,
          "is_file": false,
          "default": false,
          "default_kind": "literal",
          "default_note": null
        }
      ],
      "examples": [
        {
          "title": "chain from a previous rfdiffusion job",
          "curl": "curl -X POST $URL/api/proteinmpnn -F 'input_quiver_uri=job://abc123def456/1_rfdiffusion.qv' -F seqs_per_struct=4",
          "python": "r = httpx.post(\n    f'{base_url}/api/proteinmpnn',\n    data={\n        'input_quiver_uri': f'job://{rfdiffusion_job_id}/1_rfdiffusion.qv',\n        'seqs_per_struct': 4,\n    },\n)",
          "body": null,
          "notes": "Preferred path: cite the previous job's output via job:// rather than re-uploading the Quiver. The NAS is shared so this is a zero-copy operation."
        },
        {
          "title": "upload a Quiver file directly",
          "curl": "curl -X POST $URL/api/proteinmpnn -F input_quiver=@1_rfdiffusion.qv -F seqs_per_struct=4",
          "python": null,
          "body": null,
          "notes": "Fallback when the upstream job isn't accessible on this NAS."
        }
      ]
    },
