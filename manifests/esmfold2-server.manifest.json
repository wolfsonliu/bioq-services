      "examples": [
        {
          "title": "single protein, single-sequence mode",
          "curl": "curl -X POST $URL/api/fold -F 'sequences=[{\"type\":\"protein\",\"id\":\"A\",\"sequence\":\"MQIFVKTLTGKTITLEVEPSDTIENVKAKIQDKEGIPPDQQRLIFAGKQLEDGRTLSDYNIQKESTLHLVLRLRGG\"}]'",
          "python": null,
          "body": null,
          "notes": "Ubiquitin (76 aa). Single-sequence mode, no MSA needed."
        },
        {
          "title": "protein-DNA complex with ligand",
          "curl": "curl -X POST $URL/api/fold -F num_loops=3 -F num_sampling_steps=50 -F 'sequences=[{\"type\":\"protein\",\"id\":\"A\",\"sequence\":\"MIEIKDKQLTGLR...\"},{\"type\":\"dna\",\"id\":\"B\",\"sequence\":\"GATAGCGCTATC\"},{\"type\":\"ligand\",\"id\":\"L\",\"ccd\":[\"SAH\"]}]'",
          "python": null,
          "body": null,
          "notes": "Multi-chain complex with DNA and small molecule ligand."
