  "components": {
    "schemas": {
      "Body__task_handler_api_tasks_generate_post": {
        "properties": {
          "n_mols": {
            "type": "integer",
            "title": "N Mols",
            "description": "Number of molecules to generate. Batched sampling; runtime scales linearly in ceil(n_mols / max_batch_size) forward passes.",
            "default": 100
          },
          "n_timesteps": {
            "type": "integer",
            "title": "N Timesteps",
            "description": "Number of Euler integration steps. 250 is the paper sweet spot; 100 already usable at slightly lower PB-Valid rate.",
            "default": 250
          },
          "n_atoms_per_mol": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "N Atoms Per Mol",
            "description": "If set, every molecule has exactly this many atoms. Default (null) samples atom counts from the training distribution per molecule — recommended.",
            "bioq_default": {
              "kind": "unset",
              "note": "only used when explicitly provided"
            }
          },
          "model_variant": {
            "type": "string",
            "enum": [
              "flowmol3",
              "fm3_nodistort",
              "fm3_none",
              "fm3_ahigh",
              "fm3_alow",
              "fm3_chigh",
              "fm3_clow",
              "fm3_ehigh",
              "fm3_elow",
              "fm3_xhigh",
              "fm3_xlow",
              "fm3_distort_extreme",
              "fm3_distort_highp",
              "fm3_distort_hight",
              "fm3_distort_lowp",
              "fm3_distort_lowt",
              "fm3_fa_highp",
              "fm3_fa_highstd",
              "fm3_fa_lowp",
              "fm3_fa_lowstd",
              "fm3_scprop_high",
              "fm3_scprop_low"
            ],
            "title": "Model Variant",
            "description": "Which trained model to use. See flowmol3 wiki for the 3 primary + 19 ablation variants. `flowmol3` is the paper SOTA (default). Only pre-staged variants on NAS are usable — check /healthz/detail.staged_variants.",
            "default": "flowmol3"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "pytorch-lightning `seed_everything`; null → framework fills a random seed and records it in JobInfo.input_params.",
            "bioq_default": {
              "kind": "auto",
              "note": "random seed selected by the tool at runtime"
            }
          },
          "stochasticity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stochasticity",
            "description": "CTMC sampling stochasticity η_t. Applies to `fm3_*` CTMC-parameterised variants (all of them). Null → upstream config default.",
            "bioq_default": {
              "kind": "unset",
              "note": "only used when explicitly provided"
            }
          },
          "hc_thresh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hc Thresh",
            "description": "High-confidence threshold for CTMC purity sampling. Null → upstream config default.",
            "bioq_default": {
              "kind": "unset",
              "note": "only used when explicitly provided"
            }
          },
          "max_batch_size": {
            "type": "integer",
            "title": "Max Batch Size",
            "description": "Sampling batch size cap. n_mols > max_batch_size splits into ceil(n_mols / max_batch_size) forward passes.",
            "default": 128
          }
        },
        "type": "object",
        "title": "Body__task_handler_api_tasks_generate_post"
      },
      "Body_post_generate_api_generate_post": {
        "properties": {
          "n_mols": {
