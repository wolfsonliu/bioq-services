            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Kind",
            "description": "'literal' | 'auto' | 'unset'. 'auto'/'unset' are semantics tokens (not sendable literals); 'literal' means `default` is a real value."
          },
          "default_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Note",
            "description": "One-line prose for the 'auto'/'unset' omission semantics."
          }
        },
        "type": "object",
        "required": [
          "name",
          "type",
          "required"
        ],
        "title": "FieldInfo",
        "description": "One request-body field, flattened from the OpenAPI schema."
