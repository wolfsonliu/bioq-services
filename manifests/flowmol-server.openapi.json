        "description": "Coarse classification of why a job failed.\n\nSet by `finalize_job` based on subprocess return code + output detection,\nor by `reload_from_disk` when a job was RUNNING at the moment of restart.\nLets the client distinguish recoverable from fatal failures without parsing\n`error_summary` strings."
      },
      "FieldInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Field name as it appears in the request body / form."
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Human-friendly type name: 'string', 'integer', 'file' (multipart upload), 'array[string]', 'array[file]', or the name of a referenced pydantic model (in which case look it up in /openapi.json#/components/schemas)."
          },
          "required": {
            "type": "boolean",
