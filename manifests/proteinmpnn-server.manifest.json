      "examples": [
        {
          "title": "basic vanilla design",
          "curl": "curl -X POST $URL/api/design -F pdb=@input.pdb -F model_variant=vanilla -F model_name=v_48_020 -F num_seq_per_target=8 -F sampling_temp=0.1 -F name=run1",
          "python": null,
          "body": null,
