          "default": "X",
          "default_kind": "literal",
          "default_note": null
        },
        {
          "name": "omit_AA_per_chain",
          "type": "string",
          "required": false,
          "description": null,
          "is_file": false,
          "default": "unset",
          "default_kind": "unset",
          "default_note": "only used when explicitly provided"
